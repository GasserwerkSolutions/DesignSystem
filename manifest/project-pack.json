{
  "schemaVersion": 1,
  "id": "project",
  "label": "Projektseiten-Pack (Bildführung, Referenzen, Projektseiten)",
  "entry": "patterns/project.css",
  "requires": [
    "main.css",
    "patterns/website.css"
  ],
  "javascript": {
    "gallery": "setupGallery"
  },
  "imageRatios": {
    "pano": "21/9",
    "wide": "16/9",
    "classic": "3/2",
    "photo": "4/3",
    "square": "1/1",
    "portrait": "3/4"
  },
  "patterns": [
    {
      "id": "media",
      "css": "patterns/media.css",
      "root": ".media",
      "slots": {
        "image": {
          "required": true,
          "alt": true,
          "intrinsicSize": true
        },
        "caption": {
          "maxChars": 140
        },
        "label": {
          "maxChars": 16
        }
      },
      "rules": [
        {
          "id": "media-one-image",
          "selector": ".media__frame",
          "count": "img",
          "min": 1,
          "max": 1
        }
      ]
    },
    {
      "id": "hero-stage",
      "css": "patterns/hero-stage.css",
      "root": ".hero--stage, .hero--head",
      "slots": {
        "eyebrow": {
          "maxChars": 40
        },
        "title": {
          "required": true,
          "maxChars": 60
        },
        "lead": {
          "maxChars": 180
        },
        "image": {
          "minWidth": {
            "stage": 1920,
            "head": 1280
          },
          "note": "Querformat; frontale Ansicht bevorzugt"
        }
      },
      "rules": [
        {
          "id": "hero-one-title",
          "selector": ".hero--stage, .hero--head",
          "count": ".hero__title",
          "min": 1,
          "max": 1
        },
        {
          "id": "hero-max-one-image",
          "selector": ".hero--stage, .hero--head",
          "count": ".hero__backdrop img",
          "min": 0,
          "max": 1
        }
      ]
    },
    {
      "id": "project-facts",
      "css": "patterns/project-facts.css",
      "root": ".project-facts",
      "slots": {
        "item": {
          "term": {
            "maxChars": 18
          },
          "value": {
            "maxChars": 24
          }
        }
      },
      "rules": [
        {
          "id": "facts-count",
          "selector": ".project-facts",
          "count": ".project-facts__item",
          "min": 3,
          "max": 5
        }
      ]
    },
    {
      "id": "spec",
      "css": "patterns/spec-list.css",
      "root": ".spec",
      "needsContainer": true,
      "slots": {
        "group": {
          "title": {
            "maxChars": 32
          }
        },
        "row": {
          "term": {
            "maxChars": 20
          },
          "value": {
            "maxChars": 80
          }
        }
      },
      "rules": [
        {
          "id": "spec-groups",
          "selector": ".spec",
          "count": ".spec__group",
          "min": 2,
          "max": 6
        },
        {
          "id": "spec-rows",
          "selector": ".spec__group",
          "count": ".spec__row",
          "min": 2,
          "max": 5
        }
      ]
    },
    {
      "id": "legend-figure",
      "css": "patterns/legend-figure.css",
      "root": ".legend-figure",
      "needsContainer": true,
      "slots": {
        "mark": {
          "x": "percent",
          "y": "percent"
        },
        "item": {
          "title": {
            "maxChars": 32
          },
          "text": {
            "maxChars": 90
          }
        }
      },
      "rules": [
        {
          "id": "legend-marks",
          "selector": ".legend-figure",
          "count": ".legend-figure__mark",
          "min": 2,
          "max": 6
        },
        {
          "id": "legend-marks-match-list",
          "selector": ".legend-figure",
          "count": ".legend-figure__mark",
          "equals": ".legend-figure__list > li"
        }
      ]
    },
    {
      "id": "gallery",
      "css": "patterns/gallery.css",
      "root": ".gallery",
      "slots": {
        "item": {
          "image": {
            "alt": true,
            "intrinsicSize": true
          },
          "caption": {
            "maxChars": 80
          }
        }
      },
      "variants": {
        "default": "4 bis 12 Bilder, ideal Vielfache von 4",
        "lead": "5, 9 oder 13 Bilder (4n + 1)",
        "fit": "2 bis 3 Bilder"
      },
      "rules": [
        {
          "id": "gallery-default",
          "selector": ".gallery:not(.gallery--lead):not(.gallery--fit)",
          "count": ".gallery__item",
          "min": 4,
          "max": 12
        },
        {
          "id": "gallery-lead",
          "selector": ".gallery--lead",
          "count": ".gallery__item",
          "min": 5,
          "max": 13,
          "modulo": [
            4,
            1
          ]
        },
        {
          "id": "gallery-fit",
          "selector": ".gallery--fit",
          "count": ".gallery__item",
          "min": 2,
          "max": 3
        },
        {
          "id": "gallery-needs-lightbox",
          "selector": "body:has([data-gallery])",
          "count": "dialog.lightbox",
          "min": 1,
          "max": 1
        }
      ]
    },
    {
      "id": "before-after",
      "css": "patterns/before-after.css",
      "root": ".before-after",
      "needsContainer": true,
      "slots": {
        "before": {
          "label": "Vorher"
        },
        "after": {
          "label": "Nachher"
        }
      },
      "rules": [
        {
          "id": "before-after-pair",
          "selector": ".before-after",
          "count": ".media",
          "min": 2,
          "max": 2
        },
        {
          "id": "before-after-labels",
          "selector": ".before-after",
          "count": ".media__label",
          "min": 2,
          "max": 2
        }
      ]
    },
    {
      "id": "reference-grid",
      "css": "patterns/reference-grid.css",
      "root": ".reference-grid",
      "slots": {
        "card": {
          "title": {
            "required": true,
            "maxChars": 60
          },
          "meta": {
            "maxItems": 3,
            "itemMaxChars": 28
          },
          "image": {
            "alt": true,
            "intrinsicSize": true
          }
        }
      },
      "rules": [
        {
          "id": "reference-count",
          "selector": ".reference-grid",
          "count": ".reference-card",
          "min": 3,
          "max": 24
        },
        {
          "id": "reference-meta",
          "selector": ".reference-card__meta",
          "count": "span",
          "min": 1,
          "max": 3
        },
        {
          "id": "reference-title",
          "selector": ".reference-card",
          "count": ".reference-card__title",
          "min": 1,
          "max": 1
        }
      ]
    }
  ],
  "textLimits": [
    {
      "selector": ".hero--stage .hero__title, .hero--head .hero__title",
      "maxChars": 60
    },
    {
      "selector": ".project-facts__item > dd",
      "maxChars": 24
    },
    {
      "selector": ".reference-card__title",
      "maxChars": 60
    },
    {
      "selector": ".reference-card__meta > span",
      "maxChars": 28
    },
    {
      "selector": ".media__caption",
      "maxChars": 140
    },
    {
      "selector": ".spec__row > dd",
      "maxChars": 80
    }
  ]
}
