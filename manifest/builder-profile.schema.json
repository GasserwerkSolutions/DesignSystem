{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gasserwerk.ch/schemas/design-system/builder-profile.schema.json",
  "title": "Gasserwerk Design System Builder Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "entry", "layers", "imports", "components", "patterns", "htmlContract", "compatibility"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "builder" },
    "label": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "pattern": "^profiles/.+\\.css$" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+/.+\\.css$" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    },
    "htmlContract": {
      "type": "object",
      "required": ["requiredAttributes", "densityValues", "modeValues"],
      "properties": {
        "requiredAttributes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "densityValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "modeValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["policy", "minimum"],
      "properties": {
        "policy": { "type": "string" },
        "minimum": {
          "type": "object",
          "required": ["chrome", "safari", "firefox"],
          "properties": {
            "chrome": { "type": "number" },
            "safari": { "type": "number" },
            "firefox": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "css", "contract", "javascript"],
      "properties": {
        "id": { "type": "string" },
        "css": { "type": "string" },
        "contract": { "type": "string" },
        "javascript": { "type": ["string", "null"] }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "css"],
      "properties": {
        "id": { "type": "string" },
        "css": { "type": "string" }
      }
    }
  }
}
